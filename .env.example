# --- BedLink backend wiring (frontend) ---
# Base URL of the BedLink Express server (see server/.env.example).
VITE_BEDLINK_API_URL=http://localhost:4000

# Which seeded hospital the Nurse and Hospital screens represent.
VITE_BEDLINK_HOSPITAL_ID=city-general

# Nurse token for that hospital, printed by `npm run server:seed`.
VITE_BEDLINK_NURSE_TOKEN=demo-nurse-city-general

# --- Supabase (existing auth plumbing; unrelated to bed/dispatch data) ---
# SUPABASE_PROJECT_ID=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_URL=
# VITE_SUPABASE_PROJECT_ID=
# VITE_SUPABASE_PUBLISHABLE_KEY=
# VITE_SUPABASE_URL=

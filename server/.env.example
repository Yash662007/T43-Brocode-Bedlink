# Port the Express API listens on.
PORT=4000

# Optional: path to the SQLite file. Defaults to server/data/bedlink.db.
# BEDLINK_DB_PATH=./data/bedlink.db

# Optional: base URL of a running OSRM instance (e.g. http://localhost:5000).
# When unset, travel time falls back to haversine distance at an assumed
# speed (see config/ranking.json: assumedSpeedKmh) and is labelled an estimate either way.
# OSRM_BASE_URL=http://localhost:5000

# Optional: Telegram bot token from @BotFather. When unset, the bot is disabled
# and the API/SSE/demo still work fully without it.
# TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
